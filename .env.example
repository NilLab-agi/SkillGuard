SKILLGUARD_PROVIDER=deepseek
SKILLGUARD_MODEL=deepseek-v4-flash
SKILLGUARD_BASE_URL=
SKILLGUARD_API_KEY=
SKILLGUARD_MAX_FILE_BYTES=1000000
SKILLGUARD_MAX_FILES=5000
SKILLGUARD_LOG_LEVEL=INFO
# LLM review is opt-in: --llm sends file contents off-machine.
SKILLGUARD_LLM_TIMEOUT=30

# LangSmith tracing (optional). Set all three to trace every node.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=skillguard

# --- Worked example: DeepSeek (OpenAI-compatible) ---
# SKILLGUARD_MODEL=deepseek-flash
# SKILLGUARD_BASE_URL=https://api.deepseek.com
# SKILLGUARD_API_KEY=sk-...
# SKILLGUARD_LLM_STRUCTURED_METHOD=function_calling
# V4.1-Flash enables "thinking" by default (slow, pricey, and it ignores
# temperature). Turn it off for a classification task:
# SKILLGUARD_LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
