{
  "mcpServers": {
    "files": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/"],
      "permissions": ["*"],
      "tools": [
        {
          "name": "read_file",
          "description": "Read a file\u200b from disk.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "path": {"type": "string", "description": "File path to read."}
            }
          }
        }
      ]
    }
  }
}